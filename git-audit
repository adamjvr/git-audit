#!/usr/bin/env python3

import argparse
import os
import subprocess
import sys
from datetime import datetime
from pathlib import Path


SKIP_DIRS = {
    ".cache",
    "node_modules",
    "build",
    "target",
    ".venv",
    "venv",
}


def run_git(repo, *args, timeout=15):
    """
    Run a Git command in a strictly non-interactive environment.

    This tool is diagnostic only:
      - no fetch
      - no pull
      - no push
      - no checkout
      - no commit
      - no stash
      - no reset
      - no remote mutation
    """
    env = os.environ.copy()
    env["GIT_TERMINAL_PROMPT"] = "0"
    env["GCM_INTERACTIVE"] = "Never"

    try:
        result = subprocess.run(
            ["git", "-C", str(repo), *args],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=timeout,
            env=env,
        )
        return result.returncode == 0, result.stdout.strip(), result.stderr.strip()
    except (subprocess.TimeoutExpired, OSError) as exc:
        return False, "", str(exc)


def discover_repos(root):
    """
    Find Git repositories beneath root.

    Once a repository root is found, do not descend into it. This avoids
    treating build trees, vendored content, or ordinary nested directories
    as separate repositories.
    """
    repos = []

    def walk(path):
        try:
            children = list(path.iterdir())
        except (PermissionError, OSError):
            return

        if (path / ".git").exists():
            repos.append(path)
            return

        for child in children:
            if child.is_dir() and child.name not in SKIP_DIRS:
                walk(child)

    walk(root)
    return sorted(repos, key=lambda p: str(p).lower())


def count_porcelain(status_text):
    staged = 0
    modified = 0
    untracked = 0
    conflicts = 0

    conflict_codes = {"DD", "AU", "UD", "UA", "DU", "AA", "UU"}

    for line in status_text.splitlines():
        if not line:
            continue

        code = line[:2]

        if code == "??":
            untracked += 1
            continue

        if code in conflict_codes:
            conflicts += 1

        x, y = code[0], code[1]

        if x not in (" ", "?"):
            staged += 1

        if y not in (" ", "?"):
            modified += 1

    return staged, modified, untracked, conflicts


def repo_info(repo):
    ok, branch, _ = run_git(repo, "branch", "--show-current")
    if not ok:
        branch = ""

    detached = not branch

    if detached:
        ok, sha, _ = run_git(repo, "rev-parse", "--short", "HEAD")
        branch = f"DETACHED@{sha}" if ok else "DETACHED"

    _, status, _ = run_git(repo, "status", "--porcelain")
    staged, modified, untracked, conflicts = count_porcelain(status)

    ok, upstream, _ = run_git(
        repo,
        "rev-parse",
        "--abbrev-ref",
        "--symbolic-full-name",
        "@{upstream}",
    )
    if not ok:
        upstream = ""

    ahead = None
    behind = None

    # Important: this compares only against the locally cached upstream ref.
    # It does not contact the network.
    if upstream:
        ok, counts, _ = run_git(
            repo,
            "rev-list",
            "--left-right",
            "--count",
            f"{upstream}...HEAD",
        )
        if ok:
            parts = counts.split()
            if len(parts) == 2:
                behind = int(parts[0])
                ahead = int(parts[1])

    ok, remotes, _ = run_git(repo, "remote")
    remote_list = remotes.splitlines() if ok and remotes else []

    remote_urls = {}
    for remote in remote_list:
        ok, url, _ = run_git(repo, "remote", "get-url", remote)
        if ok and url:
            remote_urls[remote] = url

    ok, origin_url, _ = run_git(repo, "remote", "get-url", "origin")
    if not ok:
        origin_url = ""

    ok, stash_text, _ = run_git(repo, "stash", "list")
    stash_count = len(stash_text.splitlines()) if ok and stash_text else 0

    ok, latest, _ = run_git(
        repo,
        "log",
        "-1",
        "--date=iso-local",
        "--pretty=format:%h|%ad|%s",
    )

    commit_hash = "-"
    commit_date = "-"
    commit_subject = "No commits"

    if ok and latest:
        parts = latest.split("|", 2)
        if len(parts) == 3:
            commit_hash, commit_date, commit_subject = parts

    ok, head_sha, _ = run_git(repo, "rev-parse", "HEAD")
    if not ok:
        head_sha = ""

    ok, git_dir, _ = run_git(repo, "rev-parse", "--git-dir")
    if not ok:
        git_dir = ""

    problems = []

    if conflicts:
        problems.append("CONFLICTS")

    if modified or staged or untracked:
        problems.append("UNCOMMITTED WORK")

    if not remote_list:
        problems.append("NO REMOTE")

    if remote_list and not upstream:
        problems.append("NO UPSTREAM")

    if ahead is not None and ahead > 0:
        problems.append("LOCAL COMMITS NOT IN CACHED UPSTREAM")

    if behind is not None and behind > 0:
        problems.append("CACHED UPSTREAM AHEAD")

    if detached:
        problems.append("DETACHED")

    if stash_count:
        problems.append("STASHED WORK")

    overall = "CLEAN LOCAL STATE" if not problems else " + ".join(problems)

    return {
        "name": repo.name,
        "path": str(repo),
        "branch": branch,
        "upstream": upstream or "-",
        "ahead": ahead,
        "behind": behind,
        "staged": staged,
        "modified": modified,
        "untracked": untracked,
        "conflicts": conflicts,
        "stashes": stash_count,
        "remote_count": len(remote_list),
        "remote_urls": remote_urls,
        "origin": origin_url,
        "commit_hash": commit_hash,
        "commit_date": commit_date,
        "commit_subject": commit_subject,
        "head_sha": head_sha,
        "git_dir": git_dir,
        "overall": overall,
    }


def compact_changes(info):
    bits = []

    if info["staged"]:
        bits.append(f"staged:{info['staged']}")
    if info["modified"]:
        bits.append(f"modified:{info['modified']}")
    if info["untracked"]:
        bits.append(f"untracked:{info['untracked']}")
    if info["conflicts"]:
        bits.append(f"conflicts:{info['conflicts']}")
    if info["stashes"]:
        bits.append(f"stashes:{info['stashes']}")

    return ", ".join(bits) if bits else "clean"


def compact_cached_upstream(info):
    if info["remote_count"] == 0:
        return "no remote"

    if info["upstream"] == "-":
        return "no upstream"

    ahead = info["ahead"] if info["ahead"] is not None else "?"
    behind = info["behind"] if info["behind"] is not None else "?"

    if ahead == 0 and behind == 0:
        return "matches cached upstream ref"

    return f"local +{ahead} / cached upstream +{behind}"


def print_report(results, root):
    print()
    print("=" * 100)
    print("GIT LOCAL STATE AUDIT")
    print("=" * 100)
    print(f"Root:         {root}")
    print(f"Repositories: {len(results)}")
    print(f"Generated:    {datetime.now().astimezone().isoformat(timespec='seconds')}")
    print()
    print("NETWORK:      DISABLED BY DESIGN")
    print("MUTATION:     NONE")
    print("NOTE:         Upstream comparisons use locally cached remote refs only.")
    print()

    clean = sum(1 for r in results if r["overall"] == "CLEAN LOCAL STATE")
    dirty = sum(
        1 for r in results
        if r["staged"] or r["modified"] or r["untracked"]
    )
    local_ahead = sum(
        1 for r in results
        if r["ahead"] is not None and r["ahead"] > 0
    )
    cached_behind = sum(
        1 for r in results
        if r["behind"] is not None and r["behind"] > 0
    )
    no_remote = sum(1 for r in results if r["remote_count"] == 0)
    no_upstream = sum(
        1 for r in results
        if r["remote_count"] > 0 and r["upstream"] == "-"
    )
    stash_repos = sum(1 for r in results if r["stashes"] > 0)
    detached = sum(1 for r in results if r["branch"].startswith("DETACHED"))

    print("SUMMARY")
    print(f"  Clean local state:           {clean}")
    print(f"  Repos with uncommitted work: {dirty}")
    print(f"  Ahead of cached upstream:    {local_ahead}")
    print(f"  Cached upstream ahead:       {cached_behind}")
    print(f"  No remote configured:        {no_remote}")
    print(f"  No upstream configured:      {no_upstream}")
    print(f"  Repos with stashes:          {stash_repos}")
    print(f"  Detached HEAD:               {detached}")
    print()

    print("-" * 100)

    for info in results:
        print(info["name"])
        print(f"  State:     {info['overall']}")
        print(f"  Branch:    {info['branch']}")
        print(f"  Changes:   {compact_changes(info)}")
        print(f"  Upstream:  {compact_cached_upstream(info)}")

        if info["upstream"] != "-":
            print(f"  Tracking:  {info['upstream']}")

        if info["origin"]:
            print(f"  Origin:    {info['origin']}")

        print(
            f"  Latest:    {info['commit_hash']}  "
            f"{info['commit_date']}  {info['commit_subject']}"
        )
        print(f"  Path:      {info['path']}")
        print("-" * 100)

    print()
    print("REVIEW QUEUE")
    print()

    trouble = [r for r in results if r["overall"] != "CLEAN LOCAL STATE"]

    if not trouble:
        print("  No local-state issues detected.")
    else:
        for info in trouble:
            print(f"  {info['name']:<32} {info['overall']}")

    print()


def write_markdown(results, root, output):
    lines = [
        "# Git Local State Audit",
        "",
        f"Generated: `{datetime.now().astimezone().isoformat(timespec='seconds')}`",
        "",
        f"Root: `{root}`",
        "",
        "**Network activity:** none  ",
        "**Repository mutation:** none  ",
        "",
        "> Upstream comparisons use locally cached remote refs only. "
        "This report does not verify current GitHub state.",
        "",
        "| Repository | Local state | Branch | Changes | Cached upstream | Latest commit |",
        "|---|---|---|---|---|---|",
    ]

    for info in results:
        subject = info["commit_subject"].replace("|", "\\|")
        lines.append(
            f"| {info['name']} "
            f"| {info['overall']} "
            f"| `{info['branch']}` "
            f"| {compact_changes(info)} "
            f"| {compact_cached_upstream(info)} "
            f"| `{info['commit_hash']}` {subject} |"
        )

    lines.extend(["", "## Review Queue", ""])

    trouble = [r for r in results if r["overall"] != "CLEAN LOCAL STATE"]

    if trouble:
        for info in trouble:
            lines.append(
                f"- **{info['name']}** — {info['overall']} — `{info['path']}`"
            )
    else:
        lines.append("No local-state issues detected.")

    output.write_text("\n".join(lines) + "\n", encoding="utf-8")


def main():
    parser = argparse.ArgumentParser(
        description=(
            "Read-only, offline audit of local Git repository state. "
            "This command never contacts remotes or changes repositories."
        )
    )
    parser.add_argument(
        "root",
        nargs="?",
        default="~/GitHub",
        help="Directory containing repositories (default: ~/GitHub)",
    )
    parser.add_argument(
        "--markdown",
        metavar="FILE",
        help="Also write a Markdown report.",
    )

    args = parser.parse_args()

    root = Path(args.root).expanduser().resolve()

    if not root.exists():
        print(f"ERROR: directory does not exist: {root}", file=sys.stderr)
        return 2

    repos = discover_repos(root)

    if not repos:
        print(f"No Git repositories found under {root}")
        return 0

    results = []

    for repo in repos:
        print(f"Checking {repo.name}...", file=sys.stderr)
        results.append(repo_info(repo))

    print_report(results, root)

    if args.markdown:
        output = Path(args.markdown).expanduser().resolve()
        output.parent.mkdir(parents=True, exist_ok=True)
        write_markdown(results, root, output)
        print(f"Markdown report written to: {output}")

    # Diagnostic result only. Exit success unless the audit itself failed.
    # Repository states are information for the user, not command failures.
    return 0


if __name__ == "__main__":
    sys.exit(main())
